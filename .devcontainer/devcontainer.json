{
  "name": "tekmora/praetor",
  "build": {
    "dockerfile": "Dockerfile.praetor",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/go:1": {
      "installGoTools": false,
      "version": "1.27.4"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "customizations": {
    "praetor": {
      "bootstrap": {
        "version": 1,
        "state": "source-bundle",
        "builderImage": "docker.io/library/golang@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523",
        "baseImage": "mcr.microsoft.com/devcontainers/base@sha256:91eff046d5c12318fc98e59258982b87ba896c467427ed8b5dab5a02107a5db7",
        "golangciLintVersion": "v2.15.0",
        "sourceSHA256": "sha256:a9b1708df4fc21ef9a13f852db60a3db582610ee4b95e341044d48421139d4f4",
        "archiveSHA256": "sha256:b102528d6acb9a9caf47cc5a03f183c8c97a37ce6c1ea8c1bbdd997f5d6e45c8",
        "archiveParts": 8,
        "dockerfileSHA256": "sha256:37214485d98f42474b3541ede1a20d9f3ff393327373ebc17aa438810bb8d6ad"
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "aquasecurity.trivy-vulnerability-scanner",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "github.copilot",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "go.lintOnSave": "package",
        "go.lintTool": "golangci-lint",
        "go.toolsManagement.autoUpdate": false,
        "go.useLanguageServer": true,
        "security.workspace.trust.enabled": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "export PATH=\"/usr/local/bin:$PATH\"; /usr/local/bin/praetorctl compile-context && /usr/bin/make verify-all"
}
